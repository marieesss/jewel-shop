# Base de données
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=jewelryshop;Username=postgres;Password=

# Cloudinary
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# JWT (minimum 32 caractères pour HS256)
Jwt__Secret=
Jwt__Issuer=JewelryShop
Jwt__Audience=JewelryShop
Jwt__AccessTokenMinutes=15

# Email (Mailpit en local : cd jewel-api && docker compose up -d mailpit, puis http://localhost:8025)
# Email__Enabled à false (défaut) ou Email__Smtp__Host vide = envoi non configuré :
# l'API démarre, journalise un warning et les mails restent en attente.
Email__Enabled=true
Email__Smtp__Host=localhost
Email__Smtp__Port=1025
Email__Smtp__UseSsl=false
Email__FromAddress=no-reply@mycharmly.eu
Email__FromName=mycharmly
# Identifiants SMTP : inutiles avec Mailpit, secrets en staging et en production
Email__Smtp__Username=
Email__Smtp__Password=

# URL publique du front, pour les liens des mails (défaut http://localhost:5173,
# avec un warning au démarrage hors Development si la variable est absente)
App__FrontendBaseUrl=http://localhost:5173

# Compte admin créé au démarrage, en Development uniquement, s'il n'existe pas encore
# (voir CONTRIBUTING.md, « Premier compte admin en local »). Vides : aucun compte créé.
DevAdmin__Email=
DevAdmin__Password=
