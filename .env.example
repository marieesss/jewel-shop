# Copier ce fichier en .env (jamais commité) et remplir les valeurs.
# Lu automatiquement par "docker compose" pour remplacer les ${...} de compose.yaml.
# Pas d'espace autour du "=" ; éviter les caractères ; " ' $ dans les mots de passe.

# Mot de passe de l'utilisateur Postgres "jewel".  Générer :  openssl rand -hex 24
POSTGRES_PASSWORD=

# Clé de signature des JWT (32 caractères minimum).  Générer :  openssl rand -hex 32
JWT_SECRET=

# Cloudinary (stockage des images produits) — tableau de bord Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (relais SMTP des mails en staging et en production) — app.brevo.com, menu
# « SMTP & API », onglet « SMTP » : l'identifiant (Login) et une clé SMTP générée.
# Facultatifs : sans eux, le déploiement désactive l'envoi (Email__Enabled=false)
# et les mails restent en attente. Inutiles en local (Mailpit).
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Compte de connexion à pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
